# Copy to `.env.local` for local dev, and set the same names in your host's
# environment-variable settings (Cloudflare Pages / Vercel / Netlify).
#
# Everything prefixed VITE_ is inlined into the client bundle and is publicly
# readable. Use spend-limited keys.

# ── AI providers ──────────────────────────────────────────────────────────
VITE_HCNSEC_KEY=sk-...
VITE_OPENROUTER_KEY=sk-or-v1-...

# Optional overrides
# VITE_HCNSEC_ENDPOINT=https://api.hcnsec.cn/v1/chat/completions
# VITE_OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions

# Sent to OpenRouter as the attribution referer. Set to your deployed origin.
VITE_SITE_URL=http://localhost:5173

# Set to "false" to build with every AI feature disabled.
# VITE_AI_ENABLED=true

# ── Supabase (optional) ───────────────────────────────────────────────────
# Leave unset to run fully local — auth and cloud sync stay switched off.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_...
